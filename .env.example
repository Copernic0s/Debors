# Copy this file to ".env" (do NOT commit .env).
#
# Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
#
# Local backend (server/) for CMP ingest (runs on your machine only)
#
# Required for writing CMP scrape results into Supabase:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
#
# Optional: protect the local ingest endpoint with a shared secret.
# If set, the Python scraper and any client calling /api/cmp/ingest must send:
#   Authorization: Bearer <CMP_INGEST_SECRET>
CMP_INGEST_SECRET=

