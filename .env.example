# Copy this file to ".env" (do NOT commit .env).
#
# Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
# Optional: explicit agent scope mapping for non-manager users.
# Format: email=Scope A|Scope B;email2=Scope C
VITE_AGENT_SCOPE_MAP=
#
# Local backend (server/) for CMP ingest (runs on your machine only)
#
# Required for writing CMP scrape results into Supabase:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
#
# Required for CMP runner and ingest. Generate a 32-byte secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The Python scraper sends it to /api/cmp/ingest as:
#   Authorization: Bearer <CMP_INGEST_SECRET>
CMP_INGEST_SECRET=
BIND_HOST=127.0.0.1
# Reconcile only when extracted rows cover at least this share of prior current rows.
CMP_RECONCILE_MIN_RATIO=0.5
# true runs a read-only reconciliation preview; default false persists the snapshot.
CMP_INGEST_DRY_RUN=false

