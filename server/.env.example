# Copy this file to "server/.env" (do NOT commit server/.env).
# The server also loads "../.env" automatically, so you can keep everything in one .env if you prefer.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CMP_INGEST_SECRET=
# Generate at least 32 random bytes; never reuse the example value.
BIND_HOST=127.0.0.1
CMP_RECONCILE_MIN_RATIO=0.5
CMP_INGEST_DRY_RUN=false

